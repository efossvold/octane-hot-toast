{
  "name": "octane-hot-toast",
  "version": "2.6.2",
  "description": "Smoking hot Octane Notifications. Lightweight, customizable and beautiful by default.",
  "keywords": [
    "notifications",
    "octane",
    "snackbar",
    "toast"
  ],
  "license": "MIT",
  "author": "Timo Lins",
  "repository": "git+https://github.com/efossvold/octane-hot-toast",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/lib/index.cjs",
  "module": "dist/lib/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/headless/index.js",
      "require": "./dist/headless/headless/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:lib && bun run build:headless",
    "build:clean": "rm -rf dist/*",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:headless": "vite build --config vite.config.headless.ts",
    "test": "vitest",
    "lint": "oxlint --fix -f stylish",
    "size": "size-limit"
  },
  "dependencies": {
    "goober": "^2.1.19",
    "octane": "^0.1.28"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@octanejs/testing-library": "^0.1.25",
    "@octanejs/vite-plugin": "^0.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "esbuild-minify-templates": "^0.13.1",
    "install": "^0.13.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "octane": ">=0.1.25"
  },
  "engines": {
    "node": ">=22"
  }
}
